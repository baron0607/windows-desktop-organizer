<Window x:Class="WinDeskBox.UI.Controls.FenceView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WinDeskBox.UI.Controls"
        mc:Ignorable="d"
        Title="WinDeskBox"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        AllowDrop="True"
        MinWidth="220" MinHeight="140"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        DragEnter="Window_DragEnter"
        Drop="Window_Drop">

    <Window.Resources>
        <!-- 大圖示網格項目模板 (Grid Mode) -->
        <DataTemplate x:Key="GridItemTemplate" DataType="{x:Type local:FileItemViewModel}">
            <Border x:Name="ItemBorder" Width="86" Height="92" Margin="3" CornerRadius="6" Background="Transparent"
                    ToolTip="{Binding FullPath}" Cursor="Hand" MouseLeftButtonDown="Item_MouseLeftButtonDown">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="🚀 開啟" Click="MenuOpen_Click" />
                        <MenuItem Header="📂 在檔案總管中顯示" Click="MenuShowInExplorer_Click" />
                        <MenuItem Header="📋 複製完整路徑" Click="MenuCopyPath_Click" />
                        <Separator />
                        <MenuItem Header="✏️ 重新命名" Click="MenuRename_Click" />
                        <MenuItem Header="🗑️ 移至資源回收筒" Click="MenuDelete_Click" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Image Grid.Row="0" Source="{Binding Icon}" Width="44" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True" />

                    <!-- 正常顯示文字 -->
                    <TextBlock Grid.Row="1" Text="{Binding DisplayName}" Visibility="{Binding IsRenaming, Converter={x:Static local:FenceView.InverseBoolToVis}}"
                               Foreground="#FFFFFF" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis" Margin="2,2,2,0" />

                    <!-- 重新命名輸入框 -->
                    <TextBox Grid.Row="1" Text="{Binding EditingName, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsRenaming, Converter={x:Static local:FenceView.BoolToVis}}"
                             FontSize="11" Margin="2,0,2,0" KeyDown="RenameTextBox_KeyDown" LostFocus="RenameTextBox_LostFocus" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ItemBorder" Property="Background" Value="#30FFFFFF" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 詳細清單項目模板 (List Mode) -->
        <DataTemplate x:Key="ListItemTemplate" DataType="{x:Type local:FileItemViewModel}">
            <Border x:Name="ItemBorder" Height="32" Margin="2,1" CornerRadius="4" Background="Transparent"
                    ToolTip="{Binding FullPath}" Cursor="Hand" MouseLeftButtonDown="Item_MouseLeftButtonDown">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="🚀 開啟" Click="MenuOpen_Click" />
                        <MenuItem Header="📂 在檔案總管中顯示" Click="MenuShowInExplorer_Click" />
                        <MenuItem Header="📋 複製完整路徑" Click="MenuCopyPath_Click" />
                        <Separator />
                        <MenuItem Header="✏️ 重新命名" Click="MenuRename_Click" />
                        <MenuItem Header="🗑️ 移至資源回收筒" Click="MenuDelete_Click" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid Margin="4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" Source="{Binding Icon}" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True" />

                    <!-- 正常顯示文字 -->
                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Visibility="{Binding IsRenaming, Converter={x:Static local:FenceView.InverseBoolToVis}}"
                               Foreground="#FFFFFF" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="6,0,0,0" />

                    <!-- 重新命名輸入框 -->
                    <TextBox Grid.Column="1" Text="{Binding EditingName, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsRenaming, Converter={x:Static local:FenceView.BoolToVis}}"
                             FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0" KeyDown="RenameTextBox_KeyDown" LostFocus="RenameTextBox_LostFocus" />

                    <TextBlock Grid.Column="2" Text="{Binding LastModified}" Foreground="#88FFFFFF" FontSize="10" VerticalAlignment="Center" Margin="8,0,4,0" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ItemBorder" Property="Background" Value="#30FFFFFF" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <!-- 外層毛玻璃背景容器 -->
    <Border x:Name="MainBorder" CornerRadius="10" BorderBrush="#35FFFFFF" BorderThickness="1" Background="#1C1C1CE6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" /> <!-- 標題與分頁列 -->
                <RowDefinition Height="*" />  <!-- 檔案內容清單 -->
            </Grid.RowDefinitions>

            <!-- 標題列（支援拖曳移動） -->
            <Border Grid.Row="0" Background="#15FFFFFF" CornerRadius="9,9,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /> <!-- 收納盒標題 -->
                        <ColumnDefinition Width="*" />    <!-- Tabs 分頁區 -->
                        <ColumnDefinition Width="Auto" /> <!-- 右側控制按鈕 -->
                    </Grid.ColumnDefinitions>

                    <!-- 收納盒標題 -->
                    <TextBlock x:Name="TxtBoxTitle" Grid.Column="0" Text="收納盒" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />

                    <!-- 分頁列 (Tabs) -->
                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <StackPanel x:Name="TabsPanel" Orientation="Horizontal" />
                    </ScrollViewer>

                    <!-- 工具按鈕群 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 設定此收納盒 -->
                        <Button x:Name="BtnSettings" Style="{DynamicResource FluentIconButton}" ToolTip="設定此收納盒與資料夾映射" Click="BtnSettings_Click" Width="26" Height="26">
                            <TextBlock Text="⚙️" FontSize="11" Foreground="#CCCCCC" />
                        </Button>
                        <!-- 切換排列模式 (Grid / List) -->
                        <Button x:Name="BtnToggleView" Style="{DynamicResource FluentIconButton}" ToolTip="切換大圖示/清單" Click="BtnToggleView_Click" Width="26" Height="26">
                            <TextBlock Text="⊞" FontSize="14" Foreground="#CCCCCC" />
                        </Button>
                        <!-- 鎖定位置開關 -->
                        <Button x:Name="BtnLockPosition" Style="{DynamicResource FluentIconButton}" ToolTip="鎖定/解鎖收納盒位置" Click="BtnLockPosition_Click" Width="26" Height="26">
                            <TextBlock x:Name="TxtLockIcon" Text="🔓" FontSize="12" Foreground="#CCCCCC" />
                        </Button>
                        <!-- 折疊/展開按鈕 -->
                        <Button x:Name="BtnRollup" Style="{DynamicResource FluentIconButton}" ToolTip="收合/展開收納盒" Click="BtnRollup_Click" Width="26" Height="26">
                            <TextBlock x:Name="TxtRollupIcon" Text="▲" FontSize="10" Foreground="#CCCCCC" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 內容清單區域 -->
            <ScrollViewer Grid.Row="1" x:Name="ContentScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="6">
                <ItemsControl x:Name="FilesItemsControl">
                    <!-- 網格模式排版容器 -->
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel x:Name="MainWrapPanel" Orientation="Horizontal" IsItemsHost="True" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>