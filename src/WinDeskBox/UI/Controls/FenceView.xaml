<Window x:Class="WinDeskBox.UI.Controls.FenceView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WinDeskBox.UI.Controls"
        mc:Ignorable="d"
        Title="WinDeskBox"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        AllowDrop="True"
        MinWidth="180" MinHeight="100"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.BitmapScalingMode="HighQuality"
        RenderOptions.ClearTypeHint="Enabled"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        SizeChanged="Window_SizeChanged"
        LocationChanged="Window_LocationChanged"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        DragEnter="Window_DragEnter"
        Drop="Window_Drop">

    <Window.Resources>
        <!-- 大圖示網格項目模板 (Grid Mode) -->
        <DataTemplate x:Key="GridItemTemplate" DataType="{x:Type local:FileItemViewModel}">
            <Border x:Name="ItemBorder" Width="82" Height="86" Margin="3" CornerRadius="3" Background="Transparent"
                    BorderThickness="1" BorderBrush="Transparent"
                    ToolTip="{Binding FullPath}" Cursor="Hand" MouseLeftButtonDown="Item_MouseLeftButtonDown"
                    SnapsToDevicePixels="True" UseLayoutRounding="True">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="🚀 開啟" Click="MenuOpen_Click" />
                        <MenuItem Header="📂 在檔案總管中顯示" Click="MenuShowInExplorer_Click" />
                        <MenuItem Header="📋 複製完整路徑" Click="MenuCopyPath_Click" />
                        <Separator />
                        <MenuItem Header="✏️ 重新命名" Click="MenuRename_Click" />
                        <MenuItem Header="🗑️ 移至資源回收筒" Click="MenuDelete_Click" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid VerticalAlignment="Center" Margin="2" SnapsToDevicePixels="True" UseLayoutRounding="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 圖示（原生超高畫質像素對齊，無任何模糊光暈） -->
                    <Grid Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <Image Source="{Binding Icon}" Width="40" Height="40"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               RenderOptions.EdgeMode="Aliased"
                               SnapsToDevicePixels="True" UseLayoutRounding="True" />
                    </Grid>

                    <!-- 極度銳利純白 ClearType 文字 (移除軟體模糊陰影) -->
                    <TextBlock Grid.Row="1" Text="{Binding DisplayName}" Visibility="{Binding IsRenaming, Converter={x:Static local:FenceView.InverseBoolToVis}}"
                               Foreground="#FFFFFF" FontSize="11.5" FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft JhengHei"
                               TextAlignment="Center" TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis" Margin="2,2,2,0"
                               TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
                               SnapsToDevicePixels="True" UseLayoutRounding="True" />

                    <!-- 重新命名輸入框 -->
                    <TextBox Grid.Row="1" Text="{Binding EditingName, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsRenaming, Converter={x:Static local:FenceView.BoolToVis}}"
                             FontSize="11" Margin="2,0,2,0" Background="#1E1E1E" Foreground="White" BorderBrush="#0078D4" KeyDown="RenameTextBox_KeyDown" LostFocus="RenameTextBox_LostFocus" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ItemBorder" Property="Background" Value="#25FFFFFF" />
                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#30FFFFFF" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 詳細清單項目模板 (List Mode) -->
        <DataTemplate x:Key="ListItemTemplate" DataType="{x:Type local:FileItemViewModel}">
            <Border x:Name="ItemBorder" Height="30" Margin="2,1" CornerRadius="3" Background="Transparent"
                    BorderThickness="1" BorderBrush="Transparent"
                    ToolTip="{Binding FullPath}" Cursor="Hand" MouseLeftButtonDown="Item_MouseLeftButtonDown"
                    SnapsToDevicePixels="True" UseLayoutRounding="True">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="🚀 開啟" Click="MenuOpen_Click" />
                        <MenuItem Header="📂 在檔案總管中顯示" Click="MenuShowInExplorer_Click" />
                        <MenuItem Header="📋 複製完整路徑" Click="MenuCopyPath_Click" />
                        <Separator />
                        <MenuItem Header="✏️ 重新命名" Click="MenuRename_Click" />
                        <MenuItem Header="🗑️ 移至資源回收筒" Click="MenuDelete_Click" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid Margin="6,0" SnapsToDevicePixels="True" UseLayoutRounding="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" Source="{Binding Icon}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           RenderOptions.EdgeMode="Aliased"
                           SnapsToDevicePixels="True" UseLayoutRounding="True" />

                    <!-- 極度銳利純白 ClearType 文字 -->
                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Visibility="{Binding IsRenaming, Converter={x:Static local:FenceView.InverseBoolToVis}}"
                               Foreground="#FFFFFF" FontSize="11.5" FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft JhengHei"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="6,0,0,0"
                               TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
                               SnapsToDevicePixels="True" UseLayoutRounding="True" />

                    <!-- 重新命名輸入框 -->
                    <TextBox Grid.Column="1" Text="{Binding EditingName, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsRenaming, Converter={x:Static local:FenceView.BoolToVis}}"
                             FontSize="11.5" VerticalAlignment="Center" Margin="6,0,0,0" Background="#1E1E1E" Foreground="White" BorderBrush="#0078D4" KeyDown="RenameTextBox_KeyDown" LostFocus="RenameTextBox_LostFocus" />

                    <TextBlock Grid.Column="2" Text="{Binding LastModified}" Foreground="#A0FFFFFF" FontSize="10" VerticalAlignment="Center" Margin="8,0,4,0"
                               TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" SnapsToDevicePixels="True" UseLayoutRounding="True" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ItemBorder" Property="Background" Value="#25FFFFFF" />
                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#30FFFFFF" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <!-- 外層收納盒純粹中性透明灰色容器 (完全移除容器級 DropShadowEffect，確保內部所有圖示與文字 100% 像素點對點極度清晰) -->
    <Border x:Name="MainBorder" CornerRadius="3" BorderThickness="1" BorderBrush="#505050" Background="#BA363636" SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
            <!-- 8 向全方位邊界拉伸控制 Thumb (純 WPF 原生實作，100% 穩定，透明無感) -->
            <Grid x:Name="ResizeGrid" Panel.ZIndex="999" SnapsToDevicePixels="True" UseLayoutRounding="True">
                <!-- 4 邊 -->
                <Thumb x:Name="ResizeTop" Height="5" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="6,0,6,0" Cursor="SizeNS" DragDelta="Resize_DragDelta" Tag="Top">
                    <Thumb.Template><ControlTemplate><Rectangle Fill="Transparent" /></ControlTemplate></Thumb.Template>
                </Thumb>
                <Thumb x:Name="ResizeBottom" Height="5" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="6,0,6,0" Cursor="SizeNS" DragDelta="Resize_DragDelta" Tag="Bottom">
                    <Thumb.Template><ControlTemplate><Rectangle Fill="Transparent" /></ControlTemplate></Thumb.Template>
                </Thumb>
                <Thumb x:Name="ResizeLeft" Width="5" HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="0,6,0,6" Cursor="SizeWE" DragDelta="Resize_DragDelta" Tag="Left">
                    <Thumb.Template><ControlTemplate><Rectangle Fill="Transparent" /></ControlTemplate></Thumb.Template>
                </Thumb>
                <Thumb x:Name="ResizeRight" Width="5" HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,6,0,6" Cursor="SizeWE" DragDelta="Resize_DragDelta" Tag="Right">
                    <Thumb.Template><ControlTemplate><Rectangle Fill="Transparent" /></ControlTemplate></Thumb.Template>
                </Thumb>

                <!-- 4 圓角 -->
                <Thumb x:Name="ResizeTopLeft" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" DragDelta="Resize_DragDelta" Tag="TopLeft">
                    <Thumb.Template><ControlTemplate><Rectangle Fill="Transparent" /></ControlTemplate></Thumb.Template>
                </Thumb>
                <Thumb x:Name="ResizeTopRight" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" DragDelta="Resize_DragDelta" Tag="TopRight">
                    <Thumb.Template><ControlTemplate><Rectangle Fill="Transparent" /></ControlTemplate></Thumb.Template>
                </Thumb>
                <Thumb x:Name="ResizeBottomLeft" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" DragDelta="Resize_DragDelta" Tag="BottomLeft">
                    <Thumb.Template><ControlTemplate><Rectangle Fill="Transparent" /></ControlTemplate></Thumb.Template>
                </Thumb>
                <Thumb x:Name="ResizeBottomRight" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" DragDelta="Resize_DragDelta" Tag="BottomRight">
                    <Thumb.Template><ControlTemplate><Rectangle Fill="Transparent" /></ControlTemplate></Thumb.Template>
                </Thumb>
            </Grid>

            <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="26" /> <!-- 精巧縮小高度的標題列 (26px) -->
                    <RowDefinition Height="Auto" /> <!-- 分頁列 (Tabs, 多於1個時顯示) -->
                    <RowDefinition Height="*" />  <!-- 檔案內容清單與解鎖防護罩 -->
                </Grid.RowDefinitions>

                <!-- 標題列：精巧簡約實心深灰 (#464646, 26px 高度) -->
                <Border Grid.Row="0" Background="#464646" CornerRadius="2,2,0,0" BorderThickness="0,0,0,1" BorderBrush="#353535" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" SnapsToDevicePixels="True" UseLayoutRounding="True">
                    <Grid Margin="4,0,4,0" SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /> <!-- 左側選單 -->
                            <ColumnDefinition Width="*" />    <!-- 置中標題 -->
                            <ColumnDefinition Width="Auto" /> <!-- 右側收合按鈕 -->
                        </Grid.ColumnDefinitions>

                        <!-- 左側漢堡選單按鈕 (☰) -->
                        <Button x:Name="BtnHamburgerMenu" Grid.Column="0" Style="{DynamicResource FluentIconButton}" ToolTip="收納盒選項選單" Click="BtnHamburgerMenu_Click" Width="22" Height="22" Padding="2" SnapsToDevicePixels="True">
                            <Path Data="M3,6H21V8H3V6M3,11H21V13H3V11M3,16H21V18H3V16Z"
                                  Fill="#FFFFFF" Stretch="Uniform" Width="12" Height="12" SnapsToDevicePixels="True" />
                            <Button.ContextMenu>
                                <ContextMenu x:Name="BoxContextMenu">
                                    <MenuItem Header="⚙️ 收納盒與資料夾映射設定..." Click="MenuSettings_Click" />
                                    <MenuItem Header="📁 在檔案總管中開啟本機資料夾" Click="MenuOpenFolderInExplorer_Click" />
                                    <Separator />
                                    <MenuItem Header="🔲 切換排列模式 (大圖示 / 詳細清單)" Click="MenuToggleViewMode_Click" />
                                    <MenuItem Header="🔒 鎖定位置 (禁止拖曳與縮放)" Click="MenuToggleLockPosition_Click" />
                                    <MenuItem Header="🛡️ 隱私防護鎖定 (顯示解鎖盾牌)" Click="MenuTogglePrivacy_Click" />
                                    <MenuItem Header="✏️ 重新命名此收納盒..." Click="MenuRenameBox_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <!-- 置中標題與鎖頭狀態 -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <Path x:Name="PathLockStatus" Margin="0,0,5,0" VerticalAlignment="Center"
                                  Data="M12,17A2,2 0 0,0 14,15C14,13.89 13.1,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.89,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z"
                                  Fill="#FFFFFF" Stretch="Uniform" Width="10" Height="10" SnapsToDevicePixels="True" />
                            <TextBlock x:Name="TxtBoxTitle" Text="私人方盒" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12"
                                       FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft JhengHei" VerticalAlignment="Center"
                                       TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
                                       SnapsToDevicePixels="True" UseLayoutRounding="True" />
                        </StackPanel>

                        <!-- 右側功能按鈕群（紅框區域：開啟資料夾、切換模式、鎖定位置、隱私防護 ＋ 收合按鈕） -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <!-- 1. 在檔案總管中開啟本機資料夾 (📁) -->
                            <Button x:Name="BtnOpenFolder" Style="{DynamicResource FluentIconButton}" ToolTip="在檔案總管中開啟本機資料夾" Click="BtnOpenFolder_Click" Width="20" Height="20" Padding="2" Margin="0,0,2,0" SnapsToDevicePixels="True">
                                <Path Data="M19,20H4C2.89,20 2,19.1 2,18V6C2,4.89 2.89,4 4,4H10L12,6H19A2,2 0 0,1 21,8H21L4,8V18L6.14,10H23.21L20.93,18.5C20.7,19.37 19.92,20 19,20Z"
                                      Fill="#FFFFFF" Stretch="Uniform" Width="11" Height="11" SnapsToDevicePixels="True" />
                            </Button>

                            <!-- 2. 切換排列模式按鈕 (大圖示 / 詳細清單) -->
                            <Button x:Name="BtnToggleViewMode" Style="{DynamicResource FluentIconButton}" ToolTip="切換排列模式 (大圖示 / 詳細清單)" Click="BtnToggleViewMode_Click" Width="20" Height="20" Padding="2" Margin="0,0,2,0" SnapsToDevicePixels="True">
                                <Path x:Name="PathViewModeIcon" Data="M3,11H11V3H3M3,21H11V13H3M13,21H21V13H13M13,3V11H21V3"
                                      Fill="#FFFFFF" Stretch="Uniform" Width="10" Height="10" SnapsToDevicePixels="True" />
                            </Button>

                            <!-- 3. 鎖定位置按鈕 (🔒/🔓) -->
                            <Button x:Name="BtnToggleLock" Style="{DynamicResource FluentIconButton}" ToolTip="鎖定位置 (禁止拖曳與縮放)" Click="BtnToggleLock_Click" Width="20" Height="20" Padding="2" Margin="0,0,2,0" SnapsToDevicePixels="True">
                                <Path x:Name="PathLockBtnIcon" Data="M12,17A2,2 0 0,0 14,15C14,13.89 13.1,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.89,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z"
                                      Fill="#FFFFFF" Stretch="Uniform" Width="10" Height="10" SnapsToDevicePixels="True" />
                            </Button>

                            <!-- 4. 隱私防護鎖定按鈕 (🛡️ 顯示解鎖盾牌) -->
                            <Button x:Name="BtnTogglePrivacy" Style="{DynamicResource FluentIconButton}" ToolTip="隱私防護鎖定 (顯示解鎖盾牌)" Click="BtnTogglePrivacy_Click" Width="20" Height="20" Padding="2" Margin="0,0,2,0" SnapsToDevicePixels="True">
                                <Path x:Name="PathPrivacyBtnIcon" Data="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M12,5A6,6 0 0,1 18,11C18,14.4 15.54,17.47 12,18.42V5Z"
                                      Fill="#FFFFFF" Stretch="Uniform" Width="10" Height="10" SnapsToDevicePixels="True" />
                            </Button>

                            <!-- 5. 右側折疊/展開按鈕 (⌄) -->
                            <Button x:Name="BtnRollup" Style="{DynamicResource FluentIconButton}" ToolTip="收合/展開收納盒" Click="BtnRollup_Click" Width="20" Height="20" Padding="2" SnapsToDevicePixels="True">
                                <Path x:Name="PathRollupIcon" Data="M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z"
                                      Fill="#FFFFFF" Stretch="Uniform" Width="10" Height="10" SnapsToDevicePixels="True" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 分頁列 (Tabs, 多於1個時顯示) -->
                <Border Grid.Row="1" x:Name="TabsBorder" Background="#333333" BorderThickness="0,0,0,1" BorderBrush="#404040" Visibility="Collapsed" SnapsToDevicePixels="True">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="4,2" SnapsToDevicePixels="True">
                        <StackPanel x:Name="TabsPanel" Orientation="Horizontal" SnapsToDevicePixels="True" />
                    </ScrollViewer>
                </Border>

                <!-- 內容區域（支援隱私解鎖盾牌層） -->
                <Grid Grid.Row="2" SnapsToDevicePixels="True" UseLayoutRounding="True">
                    <!-- 檔案內容清單區域 -->
                    <ScrollViewer x:Name="ContentScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="5" SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <ItemsControl x:Name="FilesItemsControl" SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <!-- 網格模式排版容器 -->
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel x:Name="MainWrapPanel" Orientation="Horizontal" IsItemsHost="True" SnapsToDevicePixels="True" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 隱私防護鎖定層（綠色盾牌 + 按兩下以解鎖這個方盒） -->
                    <Grid x:Name="LockOverlayGrid" Background="#60202020" Visibility="Collapsed"
                          Cursor="Hand" MouseLeftButtonDown="LockOverlay_MouseLeftButtonDown" SnapsToDevicePixels="True">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True">
                            <!-- 圓形盾牌徽章 -->
                            <Border Width="50" Height="50" CornerRadius="25" Background="#383838" BorderBrush="#505050" BorderThickness="1" HorizontalAlignment="Center" SnapsToDevicePixels="True">
                                <Path Data="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1Z"
                                      Fill="#22C55E" Stretch="Uniform" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True" />
                            </Border>

                            <!-- 解鎖提示文字 -->
                            <TextBlock Text="按兩下以解鎖這個方盒!" Foreground="#FFFFFF" FontSize="12.5" FontWeight="Normal"
                                       FontFamily="Segoe UI Variable Text, Microsoft JhengHei" TextAlignment="Center" Margin="0,10,0,0"
                                       TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
                                       SnapsToDevicePixels="True" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>