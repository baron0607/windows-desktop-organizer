<Window x:Class="WinDeskBox.UI.Controls.FenceView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WinDeskBox.UI.Controls"
        mc:Ignorable="d"
        Title="WinDeskBox"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        AllowDrop="True"
        MinWidth="240" MinHeight="140"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        SizeChanged="Window_SizeChanged"
        LocationChanged="Window_LocationChanged"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        DragEnter="Window_DragEnter"
        Drop="Window_Drop">

    <Window.Resources>
        <!-- 大圖示網格項目模板 (Grid Mode) -->
        <DataTemplate x:Key="GridItemTemplate" DataType="{x:Type local:FileItemViewModel}">
            <Border x:Name="ItemBorder" Width="88" Height="94" Margin="3" CornerRadius="8" Background="Transparent"
                    BorderThickness="1" BorderBrush="Transparent"
                    ToolTip="{Binding FullPath}" Cursor="Hand" MouseLeftButtonDown="Item_MouseLeftButtonDown"
                    SnapsToDevicePixels="True">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="🚀 開啟" Click="MenuOpen_Click" />
                        <MenuItem Header="📂 在檔案總管中顯示" Click="MenuShowInExplorer_Click" />
                        <MenuItem Header="📋 複製完整路徑" Click="MenuCopyPath_Click" />
                        <Separator />
                        <MenuItem Header="✏️ 重新命名" Click="MenuRename_Click" />
                        <MenuItem Header="🗑️ 移至資源回收筒" Click="MenuDelete_Click" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid VerticalAlignment="Center" Margin="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 圖示（具備精緻立體陰影與高畫質採樣） -->
                    <Grid Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="{Binding Icon}" Width="44" Height="44"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               SnapsToDevicePixels="True">
                            <Image.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="2" Direction="270" Opacity="0.35" Color="#000000" />
                            </Image.Effect>
                        </Image>
                    </Grid>

                    <!-- 正常顯示文字（清晰微陰影抗噪） -->
                    <TextBlock Grid.Row="1" Text="{Binding DisplayName}" Visibility="{Binding IsRenaming, Converter={x:Static local:FenceView.InverseBoolToVis}}"
                               Foreground="#FFFFFF" FontSize="11.5" FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft JhengHei"
                               TextAlignment="Center" TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis" Margin="2,2,2,0">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.8" Color="#000000" />
                        </TextBlock.Effect>
                    </TextBlock>

                    <!-- 重新命名輸入框 -->
                    <TextBox Grid.Row="1" Text="{Binding EditingName, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsRenaming, Converter={x:Static local:FenceView.BoolToVis}}"
                             FontSize="11" Margin="2,0,2,0" Background="#1E1E1E" Foreground="White" BorderBrush="#0078D4" KeyDown="RenameTextBox_KeyDown" LostFocus="RenameTextBox_LostFocus" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ItemBorder" Property="Background" Value="#22FFFFFF" />
                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#30FFFFFF" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 詳細清單項目模板 (List Mode) -->
        <DataTemplate x:Key="ListItemTemplate" DataType="{x:Type local:FileItemViewModel}">
            <Border x:Name="ItemBorder" Height="34" Margin="2,1" CornerRadius="6" Background="Transparent"
                    BorderThickness="1" BorderBrush="Transparent"
                    ToolTip="{Binding FullPath}" Cursor="Hand" MouseLeftButtonDown="Item_MouseLeftButtonDown"
                    SnapsToDevicePixels="True">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="🚀 開啟" Click="MenuOpen_Click" />
                        <MenuItem Header="📂 在檔案總管中顯示" Click="MenuShowInExplorer_Click" />
                        <MenuItem Header="📋 複製完整路徑" Click="MenuCopyPath_Click" />
                        <Separator />
                        <MenuItem Header="✏️ 重新命名" Click="MenuRename_Click" />
                        <MenuItem Header="🗑️ 移至資源回收筒" Click="MenuDelete_Click" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid Margin="6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" Source="{Binding Icon}" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True">
                        <Image.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.3" Color="#000000" />
                        </Image.Effect>
                    </Image>

                    <!-- 正常顯示文字 -->
                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Visibility="{Binding IsRenaming, Converter={x:Static local:FenceView.InverseBoolToVis}}"
                               Foreground="#FFFFFF" FontSize="12" FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft JhengHei"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="6,0,0,0">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.75" Color="#000000" />
                        </TextBlock.Effect>
                    </TextBlock>

                    <!-- 重新命名輸入框 -->
                    <TextBox Grid.Column="1" Text="{Binding EditingName, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsRenaming, Converter={x:Static local:FenceView.BoolToVis}}"
                             FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0" Background="#1E1E1E" Foreground="White" BorderBrush="#0078D4" KeyDown="RenameTextBox_KeyDown" LostFocus="RenameTextBox_LostFocus" />

                    <TextBlock Grid.Column="2" Text="{Binding LastModified}" Foreground="#A0FFFFFF" FontSize="10" VerticalAlignment="Center" Margin="8,0,4,0" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ItemBorder" Property="Background" Value="#22FFFFFF" />
                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#30FFFFFF" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <!-- 外層 Fluent Acrylic 毛玻璃與微光漸層邊框容器 -->
    <Border x:Name="MainBorder" CornerRadius="12" BorderThickness="1" Background="#0C142055" SnapsToDevicePixels="True">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#60FFFFFF" Offset="0.0" />
                <GradientStop Color="#25FFFFFF" Offset="0.5" />
                <GradientStop Color="#15FFFFFF" Offset="1.0" />
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.4" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" /> <!-- 標題與分頁列 -->
                <RowDefinition Height="*" />  <!-- 檔案內容清單 -->
            </Grid.RowDefinitions>

            <!-- 標題列（支援拖曳移動與毛玻璃層次） -->
            <Border Grid.Row="0" Background="#12FFFFFF" CornerRadius="11,11,0,0" BorderThickness="0,0,0,1" BorderBrush="#15FFFFFF" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="10,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /> <!-- 收納盒標題 -->
                        <ColumnDefinition Width="*" />    <!-- Tabs 分頁區 -->
                        <ColumnDefinition Width="Auto" /> <!-- 右側控制按鈕 -->
                    </Grid.ColumnDefinitions>

                    <!-- 收納盒標題 -->
                    <TextBlock x:Name="TxtBoxTitle" Grid.Column="0" Text="收納盒" Style="{StaticResource TitleTextStyle}" Margin="0,0,10,0" />

                    <!-- 分頁列 (Tabs) -->
                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <StackPanel x:Name="TabsPanel" Orientation="Horizontal" />
                    </ScrollViewer>

                    <!-- 現代化精緻向量圖示工具按鈕群 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 設定此收納盒 (Gear Vector) -->
                        <Button x:Name="BtnSettings" Style="{DynamicResource FluentIconButton}" ToolTip="設定此收納盒與資料夾映射" Click="BtnSettings_Click" Width="28" Height="28">
                            <Path Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Width="13" Height="13" />
                        </Button>

                        <!-- 切換排列模式 (Grid Vector) -->
                        <Button x:Name="BtnToggleView" Style="{DynamicResource FluentIconButton}" ToolTip="切換大圖示/詳細清單" Click="BtnToggleView_Click" Width="28" Height="28">
                            <Path Data="M3,3H11V11H3V3M13,3H21V11H13V3M3,13H11V21H3V13M13,13H21V21H13V13Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Width="12" Height="12" />
                        </Button>

                        <!-- 鎖定位置開關 (Lock Vector) -->
                        <Button x:Name="BtnLockPosition" Style="{DynamicResource FluentIconButton}" ToolTip="鎖定/解鎖收納盒位置" Click="BtnLockPosition_Click" Width="28" Height="28">
                            <Path x:Name="PathLockIcon" Data="M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10A2,2 0 0,1 6,8H15V6A3,3 0 0,0 12,3A3,3 0 0,0 9,6H7A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,17A2,2 0 0,0 14,15C14,13.89 13.1,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Width="12" Height="12" />
                        </Button>

                        <!-- 折疊/展開按鈕 (Chevron Vector) -->
                        <Button x:Name="BtnRollup" Style="{DynamicResource FluentIconButton}" ToolTip="收合/展開收納盒" Click="BtnRollup_Click" Width="28" Height="28">
                            <Path x:Name="PathRollupIcon" Data="M7.41,15.41L12,10.83L16.59,15.41L18,14L12,8L6,14L7.41,15.41Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Width="11" Height="11" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 內容清單區域 -->
            <ScrollViewer Grid.Row="1" x:Name="ContentScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8">
                <ItemsControl x:Name="FilesItemsControl">
                    <!-- 網格模式排版容器 -->
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel x:Name="MainWrapPanel" Orientation="Horizontal" IsItemsHost="True" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>