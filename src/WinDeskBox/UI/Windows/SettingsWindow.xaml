<Window x:Class="WinDeskBox.UI.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinDeskBox 設定"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="780" Height="580" MinWidth="700" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        Foreground="#FFFFFF"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 頁首標題 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📦 WinDeskBox 桌面收納箱設定" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                <Border Background="#2563EB" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtAppVersion" Text="v1.0.2" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" />
                </Border>
            </StackPanel>
            <TextBlock Text="自訂桌面分區、資料夾映射與開機自啟管理" FontSize="12" Foreground="#AAAAAA" Margin="0,3,0,0" />
        </StackPanel>

        <!-- 設定分頁 TabControl -->
        <TabControl x:Name="MainTabControl" Grid.Row="1" Background="#262626" BorderBrush="#35FFFFFF" BorderThickness="1">
            <!-- 一般設定 -->
            <TabItem Header="⚙️ 一般設定">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="15">
                    <StackPanel>
                        <CheckBox x:Name="ChkStartup" Content="隨 Windows 開機自動啟動 (Launch on Startup)" Foreground="White" FontSize="13" Margin="0,8,0,12" />
                        <CheckBox x:Name="ChkGlobalLock" Content="全域鎖定所有收納盒位置 (禁止拖曳與縮放)" Foreground="White" FontSize="13" Margin="0,0,0,16" />

                        <!-- 全域切換隱藏 / 顯示快速鍵自訂設定卡片 -->
                        <Border Background="#1F1F1F" CornerRadius="6" BorderBrush="#35FFFFFF" BorderThickness="1" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="⌨️ 全域切換收納盒 隱藏 / 顯示 快速鍵：" FontWeight="SemiBold" FontSize="13.5" Foreground="#FFFFFF" />
                                <TextBlock Text="按下設定的快速鍵即可一秒切換所有收納盒之顯示或隱藏（100% 企業防毒相容）" FontSize="11.5" Foreground="#AAAAAA" Margin="0,2,0,10" />

                                <WrapPanel VerticalAlignment="Center">
                                    <TextBlock Text="組合修飾鍵：" Foreground="#DDDDDD" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12.5" />
                                    <CheckBox x:Name="ChkModAlt" Content="Alt" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <CheckBox x:Name="ChkModCtrl" Content="Ctrl" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <CheckBox x:Name="ChkModShift" Content="Shift" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <CheckBox x:Name="ChkModWin" Content="Win" Foreground="White" VerticalAlignment="Center" Margin="0,0,16,0" />

                                    <TextBlock Text="＋  主按鍵：" Foreground="#DDDDDD" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12.5" />
                                    <ComboBox x:Name="CmbHotkeyKey" Width="90" Height="26" VerticalAlignment="Center" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Separator Background="#35FFFFFF" Margin="0,0,0,15" />

                        <TextBlock Text="🧹 桌面一鍵整理工具" FontWeight="SemiBold" FontSize="14" Foreground="White" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="立即整理桌面散亂檔案" Click="BtnOrganizeDesktop_Click" Padding="14,8" Margin="0,0,10,0" Background="#0078D4" Foreground="White" BorderThickness="0" Cursor="Hand" />
                            <Button Content="一鍵還原檔案至桌面" Click="BtnRestoreDesktop_Click" Padding="14,8" Background="#3A3A3A" Foreground="White" BorderThickness="0" Cursor="Hand" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 收納盒與資料夾映射 -->
            <TabItem Header="📦 收納盒與資料夾映射">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左側收納盒清單 -->
                    <DockPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock DockPanel.Dock="Top" Text="收納盒清單：" FontWeight="SemiBold" Foreground="#CCCCCC" Margin="0,0,0,6" />
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="➕ 新增收納盒" Click="BtnAddBox_Click" Padding="8,5" Margin="0,0,6,0" Background="#0078D4" Foreground="White" BorderThickness="0" Cursor="Hand" />
                            <Button Content="➖ 刪除" Click="BtnDeleteBox_Click" Padding="8,5" Background="#3A3A3A" Foreground="White" BorderThickness="0" Cursor="Hand" />
                        </StackPanel>
                        <ListBox x:Name="LstBoxes" SelectionChanged="LstBoxes_SelectionChanged" Background="#181818" Foreground="White" BorderBrush="#35FFFFFF" DisplayMemberPath="Title" FontSize="13" />
                    </DockPanel>

                    <!-- 右側詳細屬性與 Tabs 映射設定 -->
                    <Grid Grid.Column="1" x:Name="BoxDetailPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- 收納盒標題與收合設定 -->
                            <RowDefinition Height="*" />    <!-- Tabs 分頁與路徑映射編輯區 -->
                        </Grid.RowDefinitions>

                        <!-- 收納盒標題與收合設定 -->
                        <Border Grid.Row="0" Background="#1F1F1F" CornerRadius="6" BorderBrush="#30FFFFFF" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="收納盒標題：" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox x:Name="TxtBoxTitle" Grid.Column="1" Background="#141414" Foreground="White" BorderBrush="#40FFFFFF" Padding="5" VerticalAlignment="Center" />
                                <CheckBox x:Name="ChkEnableRollup" Grid.Column="2" Content="滑鼠移出自動收合 (Roll-up)" Foreground="White" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </Grid>
                        </Border>

                        <!-- Tabs 分頁與路徑映射編輯區 -->
                        <Border Grid.Row="1" Background="#1F1F1F" CornerRadius="6" BorderBrush="#30FFFFFF" BorderThickness="1" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /> <!-- 分頁清單標題 -->
                                    <RowDefinition Height="80" />   <!-- 分頁 ListBox -->
                                    <RowDefinition Height="Auto" /> <!-- 分頁操作按鈕 -->
                                    <RowDefinition Height="*" />    <!-- 分頁路徑詳細編輯卡片 -->
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="📁 映射分頁 (Tabs) 清單：" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,6" />

                                <ListBox Grid.Row="1" x:Name="LstTabs" SelectionChanged="LstTabs_SelectionChanged" Background="#141414" Foreground="White" BorderBrush="#35FFFFFF" DisplayMemberPath="Name" FontSize="13" />

                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,8">
                                    <Button Content="➕ 新增分頁" Click="BtnAddTab_Click" Padding="8,3" Margin="0,0,6,0" Background="#0078D4" Foreground="White" BorderThickness="0" Cursor="Hand" />
                                    <Button Content="➖ 刪除分頁" Click="BtnDeleteTab_Click" Padding="8,3" Background="#3A3A3A" Foreground="White" BorderThickness="0" Cursor="Hand" />
                                </StackPanel>

                                <!-- 所選分頁路徑編輯卡片（極度明顯） -->
                                <Border Grid.Row="3" x:Name="TabDetailPanel" Background="#282828" CornerRadius="6" BorderBrush="#0078D4" BorderThickness="1" Padding="10" VerticalAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="🏷️ 分頁顯示名稱：" Foreground="#FFFFFF" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <TextBox x:Name="TxtTabName" Background="#141414" Foreground="White" BorderBrush="#40FFFFFF" Padding="5" Margin="0,0,0,8" />

                                        <TextBlock Text="📂 映射本機資料夾路徑：" Foreground="#FFFFFF" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtTabFolder" Grid.Column="0" Background="#141414" Foreground="White" BorderBrush="#40FFFFFF" Padding="5" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="📂 瀏覽選取..." Click="BtnBrowseFolder_Click" Margin="8,0,0,0" Padding="14,6" Background="#0078D4" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 頁尾儲存按鈕 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="💾 儲存並套用" Click="BtnSave_Click" Padding="20,8" Margin="0,0,10,0" Background="#0078D4" Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand" />
            <Button Content="關閉" Click="BtnCancel_Click" Padding="16,8" Background="#3A3A3A" Foreground="White" BorderThickness="0" Cursor="Hand" />
        </StackPanel>
    </Grid>
</Window>