<Window x:Class="WinDeskBox.UI.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinDeskBox 設定"
        Width="640" Height="500"
        WindowStartupLocation="CenterScreen"
        Background="#202020"
        Foreground="#FFFFFF"
        WindowStyle="SingleBorderWindow">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 頁首標題 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="📦 WinDeskBox 桌面收納箱設定" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" />
            <TextBlock Text="自訂桌面分區、資料夾映射與開機自啟管理" FontSize="12" Foreground="#AAAAAA" Margin="0,4,0,0" />
        </StackPanel>

        <!-- 設定分頁 TabControl -->
        <TabControl Grid.Row="1" Background="#282828" BorderBrush="#35FFFFFF" BorderThickness="1">
            <!-- 一般設定 -->
            <TabItem Header="⚙️ 一般設定">
                <StackPanel Margin="15">
                    <CheckBox x:Name="ChkStartup" Content="隨 Windows 開機自動啟動 (Launch on Startup)" Foreground="White" FontSize="13" Margin="0,10,0,10" />
                    <CheckBox x:Name="ChkDoubleClickHide" Content="雙擊桌面空白處一鍵隱藏/顯示所有收納盒" Foreground="White" FontSize="13" Margin="0,5,0,10" />
                    <CheckBox x:Name="ChkGlobalLock" Content="全域鎖定所有收納盒位置 (禁止拖曳與縮放)" Foreground="White" FontSize="13" Margin="0,5,0,20" />

                    <Separator Background="#35FFFFFF" Margin="0,10,0,15" />

                    <TextBlock Text="🧹 桌面一鍵整理工具" FontWeight="SemiBold" FontSize="14" Foreground="White" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="立即整理桌面散亂檔案" Click="BtnOrganizeDesktop_Click" Padding="12,6" Margin="0,0,10,0" Background="#0078D4" Foreground="White" BorderThickness="0" Cursor="Hand" />
                        <Button Content="一鍵還原檔案至桌面" Click="BtnRestoreDesktop_Click" Padding="12,6" Background="#3A3A3A" Foreground="White" BorderThickness="0" Cursor="Hand" />
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- 收納盒管理 -->
            <TabItem Header="📦 收納盒與資料夾映射">
                <Grid Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左側收納盒清單 -->
                    <DockPanel Grid.Column="0" Margin="0,0,15,0">
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="➕ 新增收納盒" Click="BtnAddBox_Click" Padding="8,4" Margin="0,0,6,0" Background="#0078D4" Foreground="White" BorderThickness="0" Cursor="Hand" />
                            <Button Content="➖ 刪除" Click="BtnDeleteBox_Click" Padding="8,4" Background="#3A3A3A" Foreground="White" BorderThickness="0" Cursor="Hand" />
                        </StackPanel>
                        <ListBox x:Name="LstBoxes" SelectionChanged="LstBoxes_SelectionChanged" Background="#1C1C1C" Foreground="White" BorderBrush="#35FFFFFF" DisplayMemberPath="Title" />
                    </DockPanel>

                    <!-- 右側詳細屬性與 Tabs 映射設定 -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="BoxDetailPanel" Visibility="Collapsed">
                            <TextBlock Text="收納盒標題：" Foreground="#CCCCCC" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtBoxTitle" Margin="0,0,0,12" Background="#1E1E1E" Foreground="White" BorderBrush="#40FFFFFF" Padding="6" />

                            <CheckBox x:Name="ChkEnableRollup" Content="滑鼠移出時自動滾動收合 (Roll-up)" Foreground="White" Margin="0,0,0,12" />

                            <TextBlock Text="📁 映射分頁 (Tabs) 清單：" FontWeight="SemiBold" Foreground="White" Margin="0,8,0,6" />
                            <ListBox x:Name="LstTabs" Height="100" SelectionChanged="LstTabs_SelectionChanged" Background="#1C1C1C" Foreground="White" BorderBrush="#35FFFFFF" DisplayMemberPath="Name" Margin="0,0,0,8" />

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="➕ 新增分頁" Click="BtnAddTab_Click" Padding="8,3" Margin="0,0,6,0" Background="#0078D4" Foreground="White" BorderThickness="0" Cursor="Hand" />
                                <Button Content="➖ 刪除分頁" Click="BtnDeleteTab_Click" Padding="8,3" Background="#3A3A3A" Foreground="White" BorderThickness="0" Cursor="Hand" />
                            </StackPanel>

                            <!-- 分頁詳細設定 -->
                            <StackPanel x:Name="TabDetailPanel" Visibility="Collapsed">
                                <TextBlock Text="分頁名稱：" Foreground="#CCCCCC" Margin="0,0,0,4" />
                                <TextBox x:Name="TxtTabName" Margin="0,0,0,8" Background="#1E1E1E" Foreground="White" BorderBrush="#40FFFFFF" Padding="4" />

                                <TextBlock Text="映射本機資料夾路徑：" Foreground="#CCCCCC" Margin="0,0,0,4" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtTabFolder" Grid.Column="0" Background="#1E1E1E" Foreground="White" BorderBrush="#40FFFFFF" Padding="4" />
                                    <Button Grid.Column="1" Content="瀏覽..." Click="BtnBrowseFolder_Click" Margin="6,0,0,0" Padding="10,4" Background="#3A3A3A" Foreground="White" BorderThickness="0" Cursor="Hand" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 頁尾儲存按鈕 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="💾 儲存並套用" Click="BtnSave_Click" Padding="16,6" Margin="0,0,10,0" Background="#0078D4" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" />
            <Button Content="關閉" Click="BtnCancel_Click" Padding="16,6" Background="#3A3A3A" Foreground="White" BorderThickness="0" Cursor="Hand" />
        </StackPanel>
    </Grid>
</Window>