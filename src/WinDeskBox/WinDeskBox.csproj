<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyTitle>WinDeskBox 桌面收納箱</AssemblyTitle>
    <Product>WinDeskBox 桌面收納箱</Product>
    <Description>Windows 11 現代化免安裝桌面分區與資料夾映射收納管理工具</Description>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Copyright>Copyright © 2026</Copyright>

    <!-- 方案 A 發布設定：Framework-Dependent 模式，直接調用微軟官方簽署之 .NET 8 Runtime，徹底杜絕 ZwWriteVirtualMemory 誤判 -->
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>